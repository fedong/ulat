# PostgreSQL connection (Coolify: the postgres container on the same box)
DATABASE_URL="postgresql://ulat:CHANGE_ME@localhost:5432/ulat"
# 32+ random bytes; sign access tokens. Rotate = sign everyone out.
JWT_SECRET="CHANGE_ME"
# Public origin used in QR codes and invite links (production: https://ulat.app)
NEXT_PUBLIC_APP_URL=""
# PayMongo (live). Leave empty for the built-in sandbox provider.
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
