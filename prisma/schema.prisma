// Ulat — Phase 1 schema. Classes keep their grading system, guardian policy
// and consultation config as JSON mirroring the @ulat/grade-math types, so
// API payloads round-trip into the exact Klass shape both clients consume.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  INSTRUCTOR
  STUDENT
  GUARDIAN
}

enum EntState {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  FREE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleSub    String?  @unique
  role         Role     @default(INSTRUCTOR)
  /// ProfileState: title, first, last, suffix, nameStyle, school, department,
  /// position, facultyId, license, mobile, office, lang, notif prefs.
  profile      Json     @default("{}")

  // Entitlement per the payments spec (§ /v1/auth/me).
  entState     EntState  @default(TRIALING)
  entUntil     DateTime?
  entMethod    String? // Card | Maya | GCash
  entCycle     String? // Monthly | Annual
  entAutoRenew Boolean   @default(false)

  // Referrals: ₱199 credit toward future billing (never cashed out).
  creditCents  Int     @default(0)
  referralCode String? @unique
  referredById String?
  referredBy   User?   @relation("referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("referrals")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes       Class[]
  refreshTokens RefreshToken[]
  enrollments   Enrollment[]
  guardianLinks GuardianLink[]

  guardianOf      GuardianStudent[] @relation("guardian")
  guardedBy       GuardianStudent[] @relation("student")
  studentInvites  StudentInvite[]
  payments        Payment[]
}

/// One checkout → one row: pending until the provider confirms, then it is
/// the invoice. `provider` is "paymongo" (live keys) or "mock" (sandbox).
model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  no          String    @unique // ULAT-2026-0001
  provider    String
  providerRef String?   @unique // PayMongo checkout session id / mock ref
  method      String // Card | Maya | GCash
  cycle       String // Monthly | Annual
  grossCents  Int
  creditCents Int       @default(0)
  netCents    Int
  status      String    @default("pending") // pending | paid | failed
  desc        String
  paidAt      DateTime?
  /// The entitlement end date this payment bought.
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

/// Account-level guardian ↔ student link (student-initiated invites): every
/// class the student joins, now or later, shares under its own policy.
model GuardianStudent {
  id            String   @id @default(cuid())
  guardianId    String
  guardian      User     @relation("guardian", fields: [guardianId], references: [id], onDelete: Cascade)
  studentUserId String
  student       User     @relation("student", fields: [studentUserId], references: [id], onDelete: Cascade)
  role          String   @default("Guardian") // Mother | Father | Grandparent | Guardian
  createdAt     DateTime @default(now())

  @@unique([guardianId, studentUserId])
  @@index([studentUserId])
}

/// A student's "Invite my guardian" code, claimed by a guardian account.
model StudentInvite {
  id            String    @id @default(cuid())
  studentUserId String
  student       User      @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  role          String    @default("Guardian")
  code          String    @unique
  claimedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([studentUserId])
}

/// A student account claimed one roster row via the class join code.
model Enrollment {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentRowId String     @unique
  studentRow   StudentRow @relation(fields: [studentRowId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([userId])
}

/// Guardian ↔ student-row link. Created as an invite (code, no guardian yet)
/// by the instructor's Sharing page; a guardian account claims the code.
/// Grouping rows of the same real student into one account-level link comes
/// once student accounts span classes.
model GuardianLink {
  id           String     @id @default(cuid())
  studentRowId String
  studentRow   StudentRow @relation(fields: [studentRowId], references: [id], onDelete: Cascade)
  guardianId   String?
  guardian     User?      @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  /// Display name + contact from the invite (e.g. "Lorna Reyes", mobile/email).
  name    String
  contact String @default("")
  role    String @default("Guardian") // Mother | Father | Grandparent | Guardian
  code    String @unique
  status  String @default("invited") // invited | active
  createdAt DateTime @default(now())

  @@index([guardianId])
  @@index([studentRowId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model Class {
  id       String  @id @default(cuid())
  ownerId  String
  owner    User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  code     String
  title    String
  section  String
  term     String
  schedule String  @default("")
  joinCode String  @unique
  periods  String[]
  /// { [period]: true } for periods marked Final.
  closed   Json    @default("{}")
  /// Grading from @ulat/grade-math: scale, passing, riskBand, groups, table,
  /// transmute, termMethod, periodWeights.
  grading  Json
  /// Class sharing policy: { Grades, Attendance, "Missing work", Remarks }.
  guardianScopes Json @default("{\"Grades\":true,\"Attendance\":true,\"Missing work\":true,\"Remarks\":false}")
  /// { slots: [{id,days,start,end,where}], note }
  consult  Json    @default("{\"slots\":[],\"note\":\"\"}")
  /// Co-instructors: [{id,name,email,status,groups,attendance,students}].
  team     Json    @default("[]")
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students    StudentRow[]
  assessments Assessment[]
  sessions    AttSession[]

  @@index([ownerId])
}

model StudentRow {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  no      String
  name    String
  last    String
  first   String
  mi      String @default("")

  flagged     Boolean   @default(false)
  consultedAt DateTime?
  remark      String    @default("")
  /// [{ text, at }] — remark history, newest last.
  remarkLog   Json      @default("[]")
  /// Soft removal: scores and marks stay in the data but the student is no
  /// longer counted or shown; re-adding by the same student number restores.
  removedAt   DateTime?
  /// "Ask student" from the Sharing page: prompt them to invite a guardian.
  guardianNudgeAt DateTime?

  scores        Score[]
  enrollment    Enrollment?
  guardianLinks GuardianLink[]

  @@index([classId])
}

model Assessment {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  name    String
  /// Component id within the class's grading JSON.
  comp    String
  period  String
  max     Float
  /// ISO date (yyyy-mm-dd), matching the grade engine's string dates.
  date    String
  notes   String @default("")
  archivedAt DateTime?

  scores Score[]

  @@index([classId, period])
}

model Score {
  studentRowId String
  student      StudentRow @relation(fields: [studentRowId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  /// Numeric string ("12.5"), "MISSED", or "EXC". Absence of a row = ungraded.
  value        String
  updatedAt    DateTime   @updatedAt

  @@id([studentRowId, assessmentId])
}

model AttSession {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  date    String
  /// Grading group id for split (Lecture/Lab) sessions; "" = whole class.
  groupId String @default("")
  /// { [studentRowId]: "P"|"L"|"A"|"E" }
  marks   Json   @default("{}")

  @@unique([classId, date, groupId])
  @@index([classId])
}
